# ========== OpenAI 兼容大模型 ==========
OPENAI_API_KEY=your-openai-or-compatible-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# ========== 高德地图 API Key ==========
# 在高德开放平台 (https://console.amap.com/) 创建应用后获取
# AMAP_WEB_KEY: 选择 "Web服务" 类型，用于后端 Python 调用搜索/地理编码等接口
AMAP_WEB_KEY=your-amap-web-key
# AMAP_JS_KEY: 选择 "JavaScript API" 类型，用于前端地图组件
AMAP_JS_KEY=your-amap-js-key

# ========== 前端（Vite 读取） ==========
# 前端高德 JS 地图 Key，与 AMAP_JS_KEY 取值一致
VITE_AMAP_JS_API_KEY=your-amap-js-key

# ========== 心知天气 API Key（可选） ==========
# 在 https://www.seniverse.com/ 注册后获取
SENIVERSE_API_KEY=your-seniverse-key

# ========== 数据库 / 向量库 ==========
DATABASE_URL=sqlite:///./system.db
CHROMA_PERSIST_DIR=./chroma_db
# 独立 Chroma 向量服务地址（docker-compose 内的 chroma 服务）；留空则使用本地嵌入式向量库
CHROMA_HTTP_URL=http://chroma:8000

# ========== 鉴权（JWT） ==========
# 生产环境请替换为随机字符串
SECRET_KEY=change-me

# ========== Tavily 网页搜索（MCP，方法2 / Python 版） ==========
# Tavily API Key：子进程内的 tavily-mcp server 用它鉴权（官网 https://app.tavily.com/）
TAVILY_API_KEY=your-tavily-key
# 启动命令：默认使用镜像构建期已预装的 Python 版 tavily-mcp 二进制（无需联网下载、不依赖 Node）。
# 如需切换形态可改：uvx tavily-mcp（需镜像装 uv）/ npx -y tavily-mcp（需镜像装 Node）
TAVILY_MCP_COMMAND=tavily-mcp
